@page
@model VehicleManagement.Web.Pages.Categories.IndexModel
@using System.Text.Json
@using VehicleManagement.Core.Constants

@{
    ViewData["Title"] = "Categories";

    var databaseJson = JsonSerializer.Serialize(
        Model.Categories.Select(c => new
        {
            id = c.Id,
            clientKey = $"existing-{c.Id}",
            name = c.Name,
            minWeight = c.MinWeight,
            maxWeight = c.MaxWeight,
            icon = c.Icon
        }));

    var draftJson = JsonSerializer.Serialize(
        Model.ProposedCategories.Select(c => new
        {
            id = c.Id,
            clientKey = c.ClientKey,
            name = c.Name,
            minWeight = c.MinWeight,
            maxWeight = c.MaxWeight,
            icon = c.Icon
        }));

    var vehicleWeightsJson =
    JsonSerializer.Serialize(Model.VehicleWeights);

    var iconsJson = JsonSerializer.Serialize(VehicleCategoryIcons.Icons);
}

<div class="category-form-page categories-unified-page">
    <div class="categories-page-header">
        <div>
            <h1>Vehicle Categories</h1>
            <p>Manage the weight ranges used to automatically categorise vehicles.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.PageErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.PageErrorMessage</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <strong>We couldn't save the category configuration.</strong>
            <div asp-validation-summary="ModelOnly" class="mt-2 mb-0"></div>
        </div>
    }

    <section class="category-range-card mb-4">
        <div class="category-range-heading">
            <h2>Current Configuration</h2>
        </div>

        <div id="currentRangeOverview" class="range-overview"></div>

        <div id="currentEmptyState" class="category-inline-empty" hidden>
            No categories are currently configured. Use <strong>+ Add</strong> below to create the first category.
        </div>

        <div class="range-rule">
            <strong>Boundary rule:</strong>
            the lower boundary is inclusive and the upper boundary is exclusive.
            A vehicle exactly on a boundary belongs to the category starting at that weight.
        </div>
    </section>

    <section class="category-range-card mb-4"
         id="proposedConfiguration"
         hidden>

    <div class="category-range-heading d-flex justify-content-between align-items-start gap-3">

        <div>
            <h2>Proposed Configuration</h2>

            <p id="proposedMessage">
                No pending changes.
            </p>
        </div>

        <span class="pending-indicator"
              id="pendingIndicator"
              hidden>
            Unsaved changes
        </span>

    </div>

    <div id="proposedRangeOverview"
         class="range-overview">
    </div>

    <div id="proposedEmptyState"
         class="category-inline-empty"
         hidden>
        No categories in the proposed configuration.
    </div>

</section>

    <section class="category-management-card" id="manageCategories">
        <div class="category-management-header">
            <div>
                <h2>Manage Categories</h2>
            </div>
        </div>

        <form method="post" asp-page-handler="SaveChanges" id="categoryManagementForm" novalidate>
            <div id="operationError" class="alert alert-danger mx-3 mt-3 mb-0" role="alert" hidden></div>
            <div id="postedCategoryInputs"></div>

            <div class="table-responsive">
                <table class="table category-management-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Lower Boundary</th>
                            <th>Upper Boundary</th>
                            <th>Icon</th>
                            <th class="category-actions-heading">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="categoryManagementBody"></tbody>
                </table>
            </div>

            <div class="category-management-footer">
                <div class="category-save-note" id="saveNote">
                    No pending changes.
                </div>
                <div class="d-flex gap-2">
                    <button type="button"
                            class="category-secondary-button"
                            id="discardChangesButton"
                            disabled>
                        Discard Changes
                    </button>
                    <button type="submit"
                            class="category-primary-button"
                            id="saveChangesButton"
                            disabled>
                        Save Changes
                    </button>
                </div>
            </div>
        </form>
    </section>
</div>


<!-- =========================================================
     ADD / EDIT - VEHICLE RECLASSIFICATION WARNING
     ========================================================= -->
<div class="modal fade" id="affectedCategoriesModal" tabindex="-1" aria-labelledby="affectedCategoriesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content category-impact-modal">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="category-impact-warning" aria-hidden="true">⚠</span>
                    <h2 class="modal-title fs-5 mb-0" id="affectedCategoriesModalLabel">Category Change Impact</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="affectedWarningText" class="category-impact-description"></p>
                <div class="table-responsive">
                    <table class="table category-impact-table align-middle mb-0">
                        <thead><tr><th>Category Change</th><th class="text-end">Vehicles Affected</th></tr></thead>
                        <tbody id="affectedCategoryTableBody"></tbody>
                        <tfoot><tr><th>Total affected</th><th class="text-end" id="affectedVehicleTotal">0</th></tr></tfoot>
                    </table>
                </div>
                <div class="category-impact-summary" id="affectedVehicleSummary"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="cancelAffectedCategoriesButton">Cancel</button>
                <button type="button" class="btn btn-warning" id="confirmAffectedCategoriesButton">Continue</button>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     DELETE CATEGORY REVIEW
     Original before/after diagram retained + vehicle impact
     ========================================================= -->
<div class="modal fade"
     id="deleteCategoryReviewModal"
     tabindex="-1"
     aria-labelledby="deleteCategoryReviewModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content delete-review-modal">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title fs-5" id="deleteCategoryReviewModalLabel">
                        Review Category Deletion
                    </h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <section class="delete-review-section">
                    <div class="delete-review-section-heading">
                        <h3>Current Configuration</h3>
                        <p>The selected category is highlighted for deletion.</p>
                    </div>
                    <div class="delete-scale" id="deleteCurrentScale"></div>
                </section>

                <section class="delete-review-section" id="deleteBoundarySection" hidden>
                    <div class="delete-review-section-heading">
                        <h3>Reassign Weight Range</h3>
                        <p id="deleteBoundaryDescription">
                            Set the new shared boundary between the remaining categories.
                        </p>
                    </div>

                    <div class="delete-boundary-simple">
                        <label for="deleteBoundaryInput" class="form-label">
                            New shared boundary
                        </label>
                        <div class="delete-boundary-input">
                            <input type="number"
                                   class="form-control"
                                   id="deleteBoundaryInput"
                                   min="0.01"
                                   step="any"
                                   inputmode="decimal"
                                   autocomplete="off" />
                            <span>kg</span>
                        </div>
                        <div class="text-danger small mt-1" id="deleteBoundaryError"></div>
                    </div>
                </section>

                <section class="delete-review-section">
                    <div class="delete-review-section-heading">
                        <h3>Configuration After Deletion</h3>
                        <p id="deleteAfterDescription">
                            The remaining categories will continue to cover all vehicle weights.
                        </p>
                    </div>
                    <div class="delete-scale delete-scale-after" id="deleteAfterScale"></div>
                </section>


                <!-- Vehicle reclassification impact added below the original diagram -->
                <section class="delete-review-section mb-0" id="deleteVehicleImpactSection">
                    <div class="delete-review-section-heading">
                        <h3>Vehicle Impact</h3>
                        <p>Vehicles currently in affected weight ranges will be reassigned as shown below.</p>
                    </div>

                    <div class="table-responsive">
                        <table class="table category-impact-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Category Change</th>
                                    <th class="text-end">Vehicles Affected</th>
                                </tr>
                            </thead>
                            <tbody id="deleteImpactTableBody"></tbody>
                            <tfoot>
                                <tr>
                                    <th>Total affected</th>
                                    <th class="text-end" id="deleteVehicleTotal">0</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="category-impact-summary" id="deleteVehicleSummary"></div>
                </section>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Continue Editing
                </button>
                <button type="button" class="btn btn-danger" id="confirmDeleteButton">
                    Confirm Delete
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const databaseCategories = @Html.Raw(databaseJson);
            const submittedDraft = @Html.Raw(draftJson);
            const vehicleWeights = @Html.Raw(vehicleWeightsJson);

            const iconSymbols = @Html.Raw(iconsJson);

            const allowedIcons = Object.entries(iconSymbols).map(([value, symbol]) => ({
                value,
                symbol,
                label: value === "suv"
                    ? "SUV"
                    : value
                        .split("-")
                        .map(part => part.charAt(0).toUpperCase() + part.slice(1))
                        .join(" ")
            }));

            const form = document.getElementById("categoryManagementForm");
            const tableBody = document.getElementById("categoryManagementBody");
            const currentOverview = document.getElementById("currentRangeOverview");
            const currentEmpty = document.getElementById("currentEmptyState");
            const proposedConfiguration = document.getElementById("proposedConfiguration");
            const proposedOverview = document.getElementById("proposedRangeOverview");
            const proposedEmpty = document.getElementById("proposedEmptyState");
            const proposedMessage = document.getElementById("proposedMessage");
            const pendingIndicator = document.getElementById("pendingIndicator");
            const saveButton = document.getElementById("saveChangesButton");
            const discardButton = document.getElementById("discardChangesButton");
            const postedInputs = document.getElementById("postedCategoryInputs");
            const operationError = document.getElementById("operationError");
            const saveNote = document.getElementById("saveNote");

            const deleteModalElement = document.getElementById("deleteCategoryReviewModal");
            const deleteModal = deleteModalElement && window.bootstrap
                ? new bootstrap.Modal(deleteModalElement)
                : null;

            const affectedModalElement = document.getElementById("affectedCategoriesModal");
            const affectedModal = affectedModalElement && window.bootstrap
                ? new bootstrap.Modal(affectedModalElement)
                : null;

            let pendingAffectedOperation = null;
            let confirmedDeletedKeys = new Set();

            const baselineDraft = normalizeClientKeys(clone(databaseCategories));
            let acceptedDraft = normalizeClientKeys(clone(submittedDraft));
            let workingDraft = clone(acceptedDraft);

            let activeMode = null;
            let activeIndex = null;
            let addCase = null;
            let operationSnapshot = null;
            let pendingDeleteIndex = null;
            let pendingDeletePreview = null;

            function clone(value) {
                return JSON.parse(JSON.stringify(value));
            }

            function makeClientKey() {
                if (window.crypto?.randomUUID) {
                    return `new-${window.crypto.randomUUID()}`;
                }
                return `new-${Date.now()}-${Math.random().toString(16).slice(2)}`;
            }

            function normalizeClientKeys(categories) {
                categories.forEach(c => {
                    c.clientKey = c.clientKey || (c.id > 0 ? `existing-${c.id}` : makeClientKey());
                });
                return categories;
            }

            function escapeHtml(value) {
                return String(value ?? "")
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");
            }

            function iconSymbol(icon) {
                const key = String(icon ?? "other").toLowerCase();
                return iconSymbols[key] ?? iconSymbols["other"];
            }

            function formatWeight(value) {
                if (value === null || value === undefined || value === "") return "";
                const number = Number(value);
                return Number.isFinite(number)
                    ? number.toLocaleString(undefined, { maximumFractionDigits: 2 })
                    : String(value);
            }

            function decimalPlaces(value) {
                const text = String(value ?? "");
                if (/e/i.test(text)) {
                    const number = Number(value);
                    if (!Number.isFinite(number)) return 99;
                    const fixed = number.toFixed(10).replace(/0+$/, "").replace(/\.$/, "");
                    return fixed.includes(".") ? fixed.split(".")[1].length : 0;
                }
                return text.includes(".") ? text.split(".")[1].length : 0;
            }

            function comparable(categories) {
                return categories.map(c => ({
                    id: Number(c.id || 0),
                    name: String(c.name ?? "").trim(),
                    minWeight: c.minWeight === "" ? "" : Number(c.minWeight),
                    maxWeight: c.maxWeight === null || c.maxWeight === "" ? null : Number(c.maxWeight),
                    icon: String(c.icon ?? "").toLowerCase()
                }));
            }

            function sameConfiguration(left, right) {
                return JSON.stringify(comparable(left)) === JSON.stringify(comparable(right));
            }

            function hasPendingChanges() {
                return !sameConfiguration(acceptedDraft, baselineDraft);
            }

            function setOperationError(message = "") {
                operationError.textContent = message;
                operationError.hidden = !message;
            }

            function renderRange(container, emptyState, categories) {
                if (!categories.length) {
                    container.innerHTML = "";
                    emptyState.hidden = false;
                    return;
                }

                emptyState.hidden = true;
                container.innerHTML = categories.map(category => `
                    <div class="range-segment">
                        <div class="range-category-icon"><span>${iconSymbol(category.icon)}</span></div>
                        <div class="range-category-name">${escapeHtml(category.name || "Unnamed")}</div>
                        <div class="range-line"><span class="range-start-point"></span></div>
                        <div class="range-values">
                            <span>${formatWeight(category.minWeight)}</span>
                            <span>${category.maxWeight === null ? "∞" : formatWeight(category.maxWeight)}</span>
                        </div>
                    </div>
                `).join("");
            }

            function renderCurrent() {
                renderRange(currentOverview, currentEmpty, baselineDraft);
            }

            function renderProposed() {
                renderRange(proposedOverview, proposedEmpty, workingDraft);
            }

            function updatePendingState() {
    const pending = hasPendingChanges();

    /* Show Proposed Configuration only when
       there are staged changes. */
    proposedConfiguration.hidden = !pending;

    pendingIndicator.hidden = !pending;

    if (pending) {
        proposedMessage.textContent =
            "Preview of the category configuration to be saved.";
    }

    saveNote.textContent = activeMode !== null
        ? "Finish or cancel the active row before saving."
        : pending
            ? "Changes are staged only. Save the complete configuration when ready."
            : "No pending changes.";

    saveButton.disabled = !pending || activeMode !== null;
    discardButton.disabled = !pending || activeMode !== null;
}

            function iconPickerHtml(selectedIcon) {
                return `
                    <tr class="category-icon-edit-row">
                        <td colspan="5">
                            <div class="category-inline-icon-picker">
                                <div class="category-inline-icon-heading">
                                    <strong>Choose Icon</strong>
                                    <span>Select an icon for this category.</span>
                                </div>
                                <div class="vehicle-icon-grid">
                                    ${allowedIcons.map(icon => `
                                        <button type="button"
                                                class="vehicle-icon-option ${selectedIcon === icon.value ? "selected" : ""}"
                                                data-icon-choice="${icon.value}"
                                                aria-pressed="${selectedIcon === icon.value}">
                                            <span class="vehicle-icon-symbol">${icon.symbol}</span>
                                            <span>${escapeHtml(icon.label)}</span>
                                        </button>
                                    `).join("")}
                                </div>
                            </div>
                        </td>
                    </tr>`;
            }

            function topAddRowHtml() {
                if (activeMode === "add" && addCase === "first" && activeIndex === 0) {
                    return addEditRowHtml(workingDraft[0], 0, true);
                }

                return `
                    <tr class="category-first-add-row ${activeMode !== null ? "row-inactive" : ""}">
                        <td colspan="4"><span class="text-muted small">Insert before the first category</span></td>
                        <td class="category-management-actions">
                            <button type="button"
                                    class="category-action-button add"
                                    data-add-before-first
                                    ${activeMode !== null ? "disabled" : ""}>+ Add</button>
                        </td>
                    </tr>`;
            }

            function displayRowHtml(category, index) {
                const isLast = index === workingDraft.length - 1;
                const isNew = Number(category.id) === 0;

                return `
                    <tr class="category-management-row ${activeMode !== null ? "row-inactive" : ""}" data-index="${index}">
                        <td>
                            <strong>${escapeHtml(category.name)}</strong>
                            ${isNew ? '<span class="category-row-badge">New</span>' : ''}
                        </td>
                        <td>${formatWeight(category.minWeight)} kg</td>
                        <td>
                            ${isLast
                                ? '<span class="category-infinity">∞</span><span class="category-final-note">Open-ended</span>'
                                : `${formatWeight(category.maxWeight)} kg`}
                        </td>
                        <td><span class="category-management-icon">${iconSymbol(category.icon)}</span></td>
                        <td class="category-management-actions">
                            <div class="category-normal-actions">
                                <button type="button" class="category-action-button add" data-add-after="${index}" ${activeMode !== null ? "disabled" : ""}>+ Add</button>
                                <button type="button" class="category-action-button edit" data-edit-index="${index}" ${activeMode !== null ? "disabled" : ""}>Edit</button>
                                <button type="button" class="category-action-button delete" data-delete-index="${index}" ${activeMode !== null ? "disabled" : ""}>Delete</button>
                            </div>
                        </td>
                    </tr>`;
            }

            function addEditRowHtml(category, index, isAdd) {
                const isFirst = index === 0;
                const isLast = index === workingDraft.length - 1;

                const lowerCell = isFirst
                    ? `<span class="category-fixed-boundary">0 kg</span><div class="category-final-note">Required start</div>`
                    : `<div class="category-boundary-edit">
                           <input type="number" class="form-control category-edit-control" data-active-min min="0" step="any" inputmode="decimal" value="${category.minWeight ?? ""}" aria-label="Lower boundary" />
                           <span class="boundary-unit">kg</span>
                       </div>`;

                const upperCell = isLast
    ? `<div class="category-upper-field">
           <div class="category-boundary-edit">
               <span class="category-infinity">∞</span>
           </div>
           <span class="category-final-note">Open-ended</span>
       </div>`
    : `<div class="category-upper-field">
           <div class="category-boundary-edit">
               <input type="number"
                      class="form-control category-edit-control"
                      data-active-max
                      min="0"
                      step="any"
                      inputmode="decimal"
                      value="${category.maxWeight ?? ""}"
                      placeholder="∞"
                      aria-label="Upper boundary" />
               <span class="boundary-unit">kg</span>
           </div>

           <span class="category-final-note">
               Leave blank for open-ended range (∞)
           </span>
       </div>`;

                return `
                    <tr class="category-management-row editing ${isAdd ? "category-new-row" : ""}" data-index="${index}">
                        <td>
                            <input type="text"
                                   class="form-control category-edit-control"
                                   data-active-name
                                   maxlength="20"
                                   autocomplete="off"
                                   value="${escapeHtml(category.name)}"
                                   placeholder="Category name"
                                   aria-label="Category name" />
                            ${isAdd ? '<span class="category-row-badge mt-1">New</span>' : ''}
                        </td>
                        <td>${lowerCell}</td>
                        <td>${upperCell}</td>
                        <td><span class="category-management-icon">${iconSymbol(category.icon)}</span></td>
                        <td class="category-management-actions">
                            <div class="category-edit-actions">
                                <button type="button" class="category-action-button done" data-done-operation>Apply</button>
                                <button type="button" class="category-action-button cancel" data-cancel-operation>Cancel</button>
                            </div>
                        </td>
                    </tr>
                    ${iconPickerHtml(category.icon)}`;
            }

            function renderTable() {
                let html = topAddRowHtml();

                for (let i = 0; i < workingDraft.length; i++) {
                    const activeRow = activeIndex === i && (activeMode === "edit" || activeMode === "add");

                    if (activeRow) {
                        if (!(activeMode === "add" && addCase === "first" && i === 0)) {
                            html += addEditRowHtml(workingDraft[i], i, activeMode === "add");
                        }
                        continue;
                    }

                    html += displayRowHtml(workingDraft[i], i);
                }

                tableBody.innerHTML = html;
                wireTableEvents();
            }

            function renderAll() {
                renderProposed();
                renderTable();
                updatePendingState();
            }

            function startAddBeforeFirst() {
                if (activeMode !== null) return;
                setOperationError();
                operationSnapshot = clone(acceptedDraft);
                workingDraft = clone(acceptedDraft);
                activeMode = "add";
                addCase = "first";
                activeIndex = 0;

                if (workingDraft.length === 0) {
                    workingDraft.push({ id: 0, clientKey: makeClientKey(), name: "", minWeight: 0, maxWeight: null, icon: "car" });
                } else {
                    workingDraft.unshift({ id: 0, clientKey: makeClientKey(), name: "", minWeight: 0, maxWeight: null, icon: "car" });
                }

                renderAll();
                focusActiveName();
            }

            function startAddAfter(index) {
                if (activeMode !== null || index < 0 || index >= acceptedDraft.length) return;
                setOperationError();
                operationSnapshot = clone(acceptedDraft);
                workingDraft = clone(acceptedDraft);
                activeMode = "add";
                activeIndex = index + 1;

                const previous = workingDraft[index];
                const wasFinal = index === workingDraft.length - 1;
                addCase = wasFinal ? "final" : "middle";

                if (wasFinal) {
                    const suggestedBoundary = Number(previous.minWeight) + 1;
                    previous.maxWeight = suggestedBoundary;
                    workingDraft.splice(activeIndex, 0, {
                        id: 0,
                        clientKey: makeClientKey(),
                        name: "",
                        minWeight: suggestedBoundary,
                        maxWeight: null,
                        icon: "car"
                    });
                } else {
                    const start = Number(previous.maxWeight);
                    const next = workingDraft[index + 1];
                    const nextUpper = next.maxWeight === null ? null : Number(next.maxWeight);
                    const suggestedUpper = nextUpper === null
                        ? start + 1
                        : Math.round(((start + nextUpper) / 2) * 100) / 100;

                    workingDraft.splice(activeIndex, 0, {
                        id: 0,
                        clientKey: makeClientKey(),
                        name: "",
                        minWeight: start,
                        maxWeight: suggestedUpper,
                        icon: "car"
                    });
                    workingDraft[activeIndex + 1].minWeight = suggestedUpper;
                }

                renderAll();
                focusActiveName();
            }

            function startEdit(index) {
                if (activeMode !== null || index < 0 || index >= acceptedDraft.length) return;
                setOperationError();
                operationSnapshot = clone(acceptedDraft);
                workingDraft = clone(acceptedDraft);
                activeMode = "edit";
                addCase = null;
                activeIndex = index;
                renderAll();
                focusActiveName();
            }

            function getActiveRow() {
                return tableBody.querySelector(`.category-management-row.editing[data-index="${activeIndex}"]`);
            }

            function focusActiveName() {
                getActiveRow()?.querySelector("[data-active-name]")?.focus();
            }

            function updateActiveOperationFromInputs() {
                if (activeMode === null || activeIndex === null) return;
                const row = getActiveRow();
                if (!row) return;

                const category = workingDraft[activeIndex];
                const nameInput = row.querySelector("[data-active-name]");
                const minInput = row.querySelector("[data-active-min]");
                const maxInput = row.querySelector("[data-active-max]");

                category.name = nameInput?.value ?? category.name;

                if (minInput) {
                    category.minWeight = minInput.value;
                    if (activeIndex > 0) {
                        workingDraft[activeIndex - 1].maxWeight = minInput.value;
                    }
                }

                if (maxInput) {
                    // A blank upper boundary means this category is open-ended.
                    // Any categories from this point upward will be detected as
                    // completely swallowed and require confirmation before removal.
                    category.maxWeight = maxInput.value === ""
                        ? null
                        : maxInput.value;

                    if (category.maxWeight !== null &&
                        activeIndex < workingDraft.length - 1) {
                        workingDraft[activeIndex + 1].minWeight = maxInput.value;
                    }
                }

                renderProposed();
            }

            function validateActiveOperation() {
                const category = workingDraft[activeIndex];
                const name = String(category.name ?? "").trim();

                if (!name) return "Category name is required.";
                if (name.length > 20) return "Category name cannot exceed 20 characters.";

                if (workingDraft.some((other, index) =>
                    index !== activeIndex &&
                    String(other.name ?? "").trim().toLowerCase() === name.toLowerCase())) {
                    return "Category names must be unique.";
                }

                if (!allowedIcons.some(x => x.value === category.icon)) {
                    return "Choose a valid icon.";
                }

                const min = Number(category.minWeight);

                if (!Number.isFinite(min) || min < 0) {
                    return "Enter a valid lower boundary.";
                }

                if (decimalPlaces(category.minWeight) > 2) {
                    return "Lower boundary can have no more than two decimal places.";
                }

                if (activeIndex === 0 && min !== 0) {
                    return "The first category must start at 0 kg.";
                }

                const isLast = activeIndex === workingDraft.length - 1;
                const isOpenEnded = category.maxWeight === null ||
                    category.maxWeight === undefined ||
                    category.maxWeight === "";

                // A non-final row may intentionally be made open-ended. The
                // affected-category review will then remove every category
                // completely covered from this lower boundary through infinity.
                if (!isOpenEnded) {
                    const max = Number(category.maxWeight);

                    if (!Number.isFinite(max)) {
                        return "Enter a valid upper boundary or leave it blank for an open-ended range.";
                    }

                    if (decimalPlaces(category.maxWeight) > 2) {
                        return "Upper boundary can have no more than two decimal places.";
                    }

                    if (max <= min) {
                        return "Upper boundary must be greater than the lower boundary.";
                    }
                }

                /*
                 * IMPORTANT:
                 * Do not reject the range merely because it passes across the
                 * immediately adjacent category. That category may be completely
                 * swallowed. The swallowed-category review below handles that
                 * case explicitly.
                 *
                 * We only validate against the nearest category that would
                 * survive outside the new/edited range.
                 */
                const swallowed = findCompletelySwallowedCategories();
                const swallowedKeys = new Set(swallowed.map(categoryKey));

                const snapshotActive = operationSnapshot?.find(original =>
                    (category.id > 0 && original.id === category.id) ||
                    (category.clientKey && original.clientKey === category.clientKey));

                const survivingOriginals = (operationSnapshot ?? [])
                    .filter(original => {
                        if (snapshotActive &&
                            categoryKey(original) === categoryKey(snapshotActive)) {
                            return false;
                        }

                        return !swallowedKeys.has(categoryKey(original));
                    })
                    .sort((a, b) => Number(a.minWeight) - Number(b.minWeight));

                const previousSurvivor = [...survivingOriginals]
                    .reverse()
                    .find(original => {
                        const originalMax = original.maxWeight === null
                            ? Number.POSITIVE_INFINITY
                            : Number(original.maxWeight);

                        return originalMax <= min;
                    });

                if (previousSurvivor &&
                    min <= Number(previousSurvivor.minWeight)) {
                    return `Lower boundary must be greater than ${formatWeight(previousSurvivor.minWeight)} kg.`;
                }

                if (!isOpenEnded) {
                    const max = Number(category.maxWeight);

                    const nextSurvivor = survivingOriginals.find(original =>
                        Number(original.minWeight) >= max);

                    if (nextSurvivor &&
                        nextSurvivor.maxWeight !== null &&
                        max >= Number(nextSurvivor.maxWeight)) {
                        return `Upper boundary must be less than ${formatWeight(nextSurvivor.maxWeight)} kg.`;
                    }
                }

                return "";
            }

            function findCompletelySwallowedCategories() {
                if (activeMode === null || activeIndex === null) return [];

                const active = workingDraft[activeIndex];
                const activeMin = Number(active.minWeight);
                const activeMax = active.maxWeight === null
                    ? Number.POSITIVE_INFINITY
                    : Number(active.maxWeight);

                if (!Number.isFinite(activeMin)) return [];

                return operationSnapshot
                    .filter(original => {
                        const sameCategory =
                            (active.id > 0 && original.id === active.id) ||
                            (active.clientKey && original.clientKey === active.clientKey);

                        if (sameCategory) return false;

                        const originalMin = Number(original.minWeight);
                        const originalMax = original.maxWeight === null
                            ? Number.POSITIVE_INFINITY
                            : Number(original.maxWeight);

                        return activeMin <= originalMin &&
                               activeMax >= originalMax;
                    });
            }

            function categoryKey(category) {
                return category.id > 0
                    ? `id:${category.id}`
                    : `key:${category.clientKey}`;
            }

            // =========================================================
// VEHICLE IMPACT HELPERS
// =========================================================
function weightBelongsToCategory(weight, category) {
    const min = Number(category.minWeight);
    if (!Number.isFinite(min) || weight < min) return false;
    if (category.maxWeight === null || category.maxWeight === undefined || category.maxWeight === "") return true;
    const max = Number(category.maxWeight);
    return Number.isFinite(max) && weight < max;
}

function findCategoryForWeight(weight, categories) {
    return categories.find(category => weightBelongsToCategory(weight, category)) ?? null;
}

function calculateVehicleMovements(currentCategories, proposedCategories) {
    const movements = new Map();
    vehicleWeights.map(Number).filter(Number.isFinite).forEach(weight => {
        const from = findCategoryForWeight(weight, currentCategories);
        const to = findCategoryForWeight(weight, proposedCategories);
        if (!from || !to || categoryKey(from) === categoryKey(to)) return;
        const key = `${categoryKey(from)}->${categoryKey(to)}`;
        if (!movements.has(key)) movements.set(key, { from, to, count: 0 });
        movements.get(key).count++;
    });
    return Array.from(movements.values());
}

function getMovementTotal(movements) {
    return movements.reduce((total, movement) => total + movement.count, 0);
}

function renderVehicleImpactTable(movements, tableBodyId, totalId, summaryId, actionText) {
    const tableBody = document.getElementById(tableBodyId);
    const total = getMovementTotal(movements);
    tableBody.innerHTML = movements.length === 0
        ? `<tr><td colspan="2" class="text-center text-muted">No vehicles will be reclassified.</td></tr>`
        : movements.map(m => `<tr><td><span class="category-impact-name">${iconSymbol(m.from.icon)} ${escapeHtml(m.from.name)}</span><span class="category-impact-arrow">→</span><span class="category-impact-name">${iconSymbol(m.to.icon)} ${escapeHtml(m.to.name)}</span></td><td class="text-end"><strong>${m.count}</strong></td></tr>`).join("");
    document.getElementById(totalId).textContent = total;
    document.getElementById(summaryId).innerHTML = total === 0
        ? `<strong>No vehicles will be reclassified.</strong>`
        : `<strong>${total} ${total === 1 ? "vehicle" : "vehicles"}</strong> will be reclassified if you ${actionText}.`;
    return total;
}

function buildActiveOperationPreview(swallowedCategories) {
    const swallowedKeys = new Set(swallowedCategories.map(categoryKey));
    const proposed = clone(workingDraft).filter(category => !swallowedKeys.has(categoryKey(category)));
    const originalActive = workingDraft[activeIndex];
    const active = proposed.find(category =>
        (originalActive.id > 0 && category.id === originalActive.id) ||
        (originalActive.clientKey && category.clientKey === originalActive.clientKey));
    if (!active) return { valid: false, error: "The active category could not be preserved." };
    const position = proposed.indexOf(active);
    if (position > 0) proposed[position - 1].maxWeight = active.minWeight;
    if (position < proposed.length - 1) proposed[position + 1].minWeight = active.maxWeight;
    if (proposed.length > 0) { proposed[0].minWeight = 0; proposed[proposed.length - 1].maxWeight = null; }
    proposed.sort((a, b) => Number(a.minWeight) - Number(b.minWeight));
    const error = validateCompleteDraft(proposed);
    return error ? { valid: false, error } : { valid: true, categories: proposed };
}

function openAffectedCategoriesModal(swallowedCategories, proposedDraft, movements) {
    if (!affectedModal) { setOperationError("The category impact dialog could not be opened. Refresh the page and try again."); return; }
    pendingAffectedOperation = { categories: clone(swallowedCategories), proposedDraft: clone(proposedDraft), movements: clone(movements) };
    const active = workingDraft[activeIndex];
    document.getElementById("affectedWarningText").textContent = `${activeMode === "add" ? "Adding" : "Editing"} "${active.name}" will reclassify existing vehicles.`;
    renderVehicleImpactTable(movements, "affectedCategoryTableBody", "affectedVehicleTotal", "affectedVehicleSummary", "continue");
    affectedModal.show();
}

            function validateCompleteDraft(categories) {
                if (!Array.isArray(categories) || categories.length === 0) {
                    return "At least one category is required.";
                }

                const ordered = [...categories]
                    .sort((a, b) => Number(a.minWeight) - Number(b.minWeight));

                if (Number(ordered[0].minWeight) !== 0) {
                    return "The first category must start at 0 kg.";
                }

                for (let i = 0; i < ordered.length; i++) {
                    const current = ordered[i];
                    const min = Number(current.minWeight);

                    if (!Number.isFinite(min) || min < 0) {
                        return `Enter a valid lower boundary for ${current.name || "the category"}.`;
                    }

                    const isLast = i === ordered.length - 1;

                    if (isLast) {
                        if (current.maxWeight !== null) {
                            return `The final category '${current.name}' must be open-ended.`;
                        }
                        continue;
                    }

                    if (current.maxWeight === null || current.maxWeight === "") {
                        return `'${current.name}' cannot be open-ended because another category follows it.`;
                    }

                    const max = Number(current.maxWeight);
                    const nextMin = Number(ordered[i + 1].minWeight);

                    if (!Number.isFinite(max) || max <= min) {
                        return `The upper boundary for '${current.name}' must be greater than its lower boundary.`;
                    }

                    if (max !== nextMin) {
                        return `The boundary between '${current.name}' and '${ordered[i + 1].name}' is invalid. Category ranges must have no gaps or overlaps.`;
                    }
                }

                return "";
            }

            function applyActiveOperation() {
                workingDraft[activeIndex].name = String(workingDraft[activeIndex].name).trim();
                workingDraft[activeIndex].minWeight = Number(workingDraft[activeIndex].minWeight);

                if (workingDraft[activeIndex].maxWeight !== null) {
                    workingDraft[activeIndex].maxWeight = Number(workingDraft[activeIndex].maxWeight);
                }

                if (activeIndex > 0) {
                    workingDraft[activeIndex - 1].maxWeight = workingDraft[activeIndex].minWeight;
                }

                if (activeIndex < workingDraft.length - 1) {
                    workingDraft[activeIndex + 1].minWeight = workingDraft[activeIndex].maxWeight;
                }

                if (workingDraft.length > 0) {
                    workingDraft[0].minWeight = 0;
                    workingDraft[workingDraft.length - 1].maxWeight = null;
                }

                // Sort after boundary changes/removals, then verify the entire
                // staged configuration before accepting it.
                workingDraft.sort((a, b) => Number(a.minWeight) - Number(b.minWeight));

                const draftError = validateCompleteDraft(workingDraft);
                if (draftError) {
                    setOperationError(draftError);
                    return false;
                }

                acceptedDraft = clone(workingDraft);
                activeMode = null;
                activeIndex = null;
                addCase = null;
                operationSnapshot = null;
                pendingAffectedOperation = null;
                setOperationError();
                renderAll();
                return true;
            }

            function finishActiveOperation() {
                updateActiveOperationFromInputs();
                const error = validateActiveOperation();
                if (error) { setOperationError(error); return; }

                const swallowed = findCompletelySwallowedCategories();
                const preview = buildActiveOperationPreview(swallowed);
                if (!preview.valid) { setOperationError(preview.error); return; }

                const movements = calculateVehicleMovements(operationSnapshot ?? acceptedDraft, preview.categories);
                if (getMovementTotal(movements) > 0 || swallowed.length > 0) {
                    openAffectedCategoriesModal(swallowed, preview.categories, movements);
                    return;
                }

                workingDraft = clone(preview.categories);
                applyActiveOperation();
            }

            function cancelActiveOperation() {
                workingDraft = clone(operationSnapshot ?? acceptedDraft);
                activeMode = null; activeIndex = null; addCase = null; operationSnapshot = null;
                setOperationError(); renderAll();
            }

            function chooseIcon(value) {
                if (activeMode === null || activeIndex === null) return;
                if (!allowedIcons.some(x => x.value === value)) return;
                workingDraft[activeIndex].icon = value;
                renderTable(); renderProposed(); focusActiveName();
            }

            function formatRange(category) {
                return category.maxWeight === null
                    ? `${formatWeight(category.minWeight)} kg and above`
                    : `${formatWeight(category.minWeight)} – ${formatWeight(category.maxWeight)} kg`;
            }

            document.getElementById("cancelAffectedCategoriesButton")?.addEventListener("click", () => {
                pendingAffectedOperation = null; affectedModal?.hide(); focusActiveName();
            });

            document.getElementById("confirmAffectedCategoriesButton")?.addEventListener("click", () => {
                if (!pendingAffectedOperation) return;
                pendingAffectedOperation.categories.forEach(category => confirmedDeletedKeys.add(categoryKey(category)));
                acceptedDraft = clone(pendingAffectedOperation.proposedDraft);
                workingDraft = clone(acceptedDraft);
                activeMode = null; activeIndex = null; addCase = null; operationSnapshot = null; pendingAffectedOperation = null;
                affectedModal?.hide(); setOperationError(); renderAll();
            });

            function buildDeletePreview(index, boundaryValue = null) {

    if (acceptedDraft.length <= 1) {
        return {
            valid: false,
            error: "At least one category must remain."
        };
    }

    const source = clone(acceptedDraft);

    const selected = source[index];

    if (!selected) {
        return {
            valid: false,
            error: "The selected category could not be found."
        };
    }

    const previous =
        index > 0
            ? source[index - 1]
            : null;

    const next =
        index < source.length - 1
            ? source[index + 1]
            : null;

    source.splice(index, 1);


    // =====================================================
    // DELETE FIRST CATEGORY
    // =====================================================

    if (!previous && next) {

        source[0].minWeight = 0;

        return {
            valid: true,
            categories: source,
            selected,
            requiresBoundary: false,
            changes: [
                `${selected.name} (${formatRange(selected)}) will be removed.`,
                `${source[0].name} will now start at 0 kg.`
            ]
        };
    }


    // =====================================================
    // DELETE FINAL CATEGORY
    // =====================================================

    if (previous && !next) {

        source[source.length - 1].maxWeight = null;

        return {
            valid: true,
            categories: source,
            selected,
            requiresBoundary: false,
            changes: [
                `${selected.name} (${formatRange(selected)}) will be removed.`,
                `${source[source.length - 1].name} will become open-ended.`
            ]
        };
    }


    // =====================================================
    // DELETE MIDDLE CATEGORY
    // =====================================================

    if (previous && next) {

        const previousAfter =
            source[index - 1];

        const nextAfter =
            source[index];

        let boundary =
            boundaryValue;


        // -------------------------------------------------
        // Default boundary = midpoint of deleted category
        // -------------------------------------------------

        if (
            boundary === null ||
            boundary === undefined ||
            boundary === ""
        ) {

            boundary =
                Math.round(
                    (
                        (
                            Number(selected.minWeight) +
                            Number(selected.maxWeight)
                        ) / 2
                    ) * 100
                ) / 100;
        }


        const numericBoundary =
            Number(boundary);


        // -------------------------------------------------
        // Must be a valid number
        // -------------------------------------------------

        if (!Number.isFinite(numericBoundary)) {

            return {
                valid: false,
                error: "Enter a valid shared boundary.",
                requiresBoundary: true,
                suggestedBoundary: boundary,
                categories: source,
                selected
            };
        }


        // -------------------------------------------------
        // Maximum 2 decimal places
        // -------------------------------------------------

        if (decimalPlaces(boundary) > 2) {

            return {
                valid: false,
                error: "Use no more than two decimal places.",
                requiresBoundary: true,
                suggestedBoundary: boundary,
                categories: source,
                selected
            };
        }


        // =================================================
        // NEW RULE:
        // Boundary must stay inside the deleted category's
        // original weight range.
        // =================================================

        const deletedMin =
            Number(selected.minWeight);

        const deletedMax =
            Number(selected.maxWeight);


        // Cannot go below deleted category.

        if (numericBoundary < deletedMin) {

            return {
                valid: false,

                error:
                    `Boundary must be at least ` +
                    `${formatWeight(deletedMin)} kg.`,

                requiresBoundary: true,
                suggestedBoundary: boundary,
                categories: source,
                selected
            };
        }


        // Cannot go above deleted category.

        if (numericBoundary > deletedMax) {

            return {
                valid: false,

                error:
                    `Boundary must not exceed ` +
                    `${formatWeight(deletedMax)} kg.`,

                requiresBoundary: true,
                suggestedBoundary: boundary,
                categories: source,
                selected
            };
        }


        // =================================================
        // APPLY NEW BOUNDARY
        // =================================================

        previousAfter.maxWeight =
            numericBoundary;

        nextAfter.minWeight =
            numericBoundary;


        return {
            valid: true,
            categories: source,
            selected,
            requiresBoundary: true,
            suggestedBoundary: numericBoundary,

            changes: [
                `${selected.name} (${formatRange(selected)}) will be removed.`,

                `${previousAfter.name} will end at ` +
                `${formatWeight(numericBoundary)} kg.`,

                `${nextAfter.name} will start at ` +
                `${formatWeight(numericBoundary)} kg.`
            ]
        };
    }


    return {
        valid: false,
        error:
            "Unable to calculate the resulting category configuration."
    };
}

            function openDeleteModal(index) {
                if (activeMode !== null) return;
                setOperationError();
                if (acceptedDraft.length <= 1) { setOperationError("At least one category must remain. The final category cannot be deleted."); return; }
                pendingDeleteIndex = index;
                const selected = acceptedDraft[index];
                const isMiddle = index > 0 && index < acceptedDraft.length - 1;
                const boundary = isMiddle ? Math.round(((Number(selected.minWeight) + Number(selected.maxWeight)) / 2) * 100) / 100 : null;
                renderDeleteModal(buildDeletePreview(index, boundary));
                if (deleteModal) deleteModal.show();
                else setOperationError("The delete dialog could not be opened. Refresh the page and try again.");
            }

            function renderDeleteModal(preview) {
                pendingDeletePreview = preview;

                const selected = acceptedDraft[pendingDeleteIndex];
                if (!selected) return;

                const selectedIndex = pendingDeleteIndex;
                const previous = selectedIndex > 0 ? acceptedDraft[selectedIndex - 1] : null;
                const next = selectedIndex < acceptedDraft.length - 1
                    ? acceptedDraft[selectedIndex + 1]
                    : null;

                // Original CURRENT CONFIGURATION diagram.
                const currentScale = document.getElementById("deleteCurrentScale");
                currentScale.style.setProperty("--delete-count", acceptedDraft.length);
                currentScale.innerHTML = acceptedDraft.map((category, index) => `
                    <div class="delete-scale-segment ${index === selectedIndex ? "deleting" : ""}">
                        <strong>${escapeHtml(category.name)}</strong>
                        <span>${escapeHtml(formatRange(category))}</span>
                        ${index === selectedIndex ? "<small>Deleting</small>" : ""}
                    </div>
                `).join("");

                // Original shared-boundary editor for a middle category.
                const boundarySection = document.getElementById("deleteBoundarySection");
                const boundaryInput = document.getElementById("deleteBoundaryInput");
                const boundaryError = document.getElementById("deleteBoundaryError");
                const boundaryDescription = document.getElementById("deleteBoundaryDescription");

                boundarySection.hidden = !preview.requiresBoundary;

                if (preview.requiresBoundary) {
                    boundaryDescription.innerHTML =
                        `Set the new boundary between <strong>${escapeHtml(previous?.name ?? "")}</strong> and <strong>${escapeHtml(next?.name ?? "")}</strong>.`;
                    boundaryInput.value = preview.suggestedBoundary ?? "";
                }

                boundaryError.textContent = preview.valid ? "" : (preview.error ?? "");

                // Original CONFIGURATION AFTER DELETION diagram.
                const afterCategories = preview.categories ?? [];
                const afterScale = document.getElementById("deleteAfterScale");
                afterScale.style.setProperty("--delete-count", Math.max(afterCategories.length, 1));
                afterScale.innerHTML = afterCategories.map(category => `
                    <div class="delete-scale-segment">
                        <strong>${escapeHtml(category.name)}</strong>
                        <span>${escapeHtml(formatRange(category))}</span>
                    </div>
                `).join("");

                const afterDescription = document.getElementById("deleteAfterDescription");

                if (selectedIndex === 0 && next) {
                    afterDescription.innerHTML =
                        `<strong>${escapeHtml(next.name)}</strong> will automatically extend down to 0 kg.`;
                } else if (selectedIndex === acceptedDraft.length - 1 && previous) {
                    afterDescription.innerHTML =
                        `<strong>${escapeHtml(previous.name)}</strong> will automatically become the final open-ended category.`;
                } else {
                    afterDescription.textContent =
                        "The remaining categories will meet at the new shared boundary.";
                }


                // New addition only: vehicle movement table beneath the original diagram.
                const movements = preview.valid && preview.categories
                    ? calculateVehicleMovements(acceptedDraft, preview.categories)
                    : [];

                renderVehicleImpactTable(
                    movements,
                    "deleteImpactTableBody",
                    "deleteVehicleTotal",
                    "deleteVehicleSummary",
                    "delete this category"
                );

                document.getElementById("confirmDeleteButton").disabled = !preview.valid;
            }

            document.getElementById("deleteBoundaryInput")?.addEventListener("input", event => {
                if (pendingDeleteIndex === null) return;
                const typedValue = event.target.value;
                renderDeleteModal(buildDeletePreview(pendingDeleteIndex, typedValue));
                document.getElementById("deleteBoundaryInput").value = typedValue;
            });

            document.getElementById("confirmDeleteButton")?.addEventListener("click", () => {
                if (!pendingDeletePreview?.valid) return;
                if (pendingDeletePreview.selected) confirmedDeletedKeys.add(categoryKey(pendingDeletePreview.selected));
                acceptedDraft = clone(pendingDeletePreview.categories);
                workingDraft = clone(acceptedDraft);
                pendingDeleteIndex = null; pendingDeletePreview = null; deleteModal?.hide(); setOperationError(); renderAll();
            });

            deleteModalElement?.addEventListener("hidden.bs.modal", () => {
                pendingDeleteIndex = null; pendingDeletePreview = null;
                const error = document.getElementById("deleteBoundaryError");
                if (error) error.textContent = "";
            });

            function wireTableEvents() {
                tableBody.querySelector("[data-add-before-first]")?.addEventListener("click", startAddBeforeFirst);
                tableBody.querySelectorAll("[data-add-after]").forEach(button => button.addEventListener("click", () => startAddAfter(Number(button.dataset.addAfter))));
                tableBody.querySelectorAll("[data-edit-index]").forEach(button => button.addEventListener("click", () => startEdit(Number(button.dataset.editIndex))));
                tableBody.querySelectorAll("[data-delete-index]").forEach(button => button.addEventListener("click", () => openDeleteModal(Number(button.dataset.deleteIndex))));
                tableBody.querySelector("[data-done-operation]")?.addEventListener("click", finishActiveOperation);
                tableBody.querySelector("[data-cancel-operation]")?.addEventListener("click", cancelActiveOperation);
                tableBody.querySelectorAll("[data-icon-choice]").forEach(button => button.addEventListener("click", () => chooseIcon(button.dataset.iconChoice)));

                const activeRow = getActiveRow();
                activeRow?.querySelector("[data-active-name]")?.addEventListener("input", updateActiveOperationFromInputs);
                activeRow?.querySelector("[data-active-min]")?.addEventListener("input", updateActiveOperationFromInputs);
                activeRow?.querySelector("[data-active-max]")?.addEventListener("input", updateActiveOperationFromInputs);
            }

            discardButton.addEventListener("click", () => {
                acceptedDraft = clone(baselineDraft);
                workingDraft = clone(baselineDraft);
                activeMode = null;
                activeIndex = null;
                addCase = null;
                operationSnapshot = null;
                setOperationError();
                renderAll();
            });

            function buildPostedInputs() {
                postedInputs.innerHTML = "";

                let confirmedDeleteIndex = 0;
                confirmedDeletedKeys.forEach(key => {
                    if (!key.startsWith("id:")) return;

                    const id = Number(key.substring(3));
                    if (!Number.isInteger(id) || id <= 0) return;

                    const hidden = document.createElement("input");
                    hidden.type = "hidden";
                    hidden.name = `ConfirmedDeletedCategoryIds[${confirmedDeleteIndex}]`;
                    hidden.value = String(id);
                    postedInputs.appendChild(hidden);
                    confirmedDeleteIndex++;
                });

                acceptedDraft.forEach((category, index) => {
                    const values = {
                        Id: category.id,
                        ClientKey: category.clientKey,
                        Name: String(category.name ?? "").trim(),
                        MinWeight: category.minWeight,
                        MaxWeight: category.maxWeight,
                        Icon: category.icon
                    };

                    Object.entries(values).forEach(([field, value]) => {
                        const input = document.createElement("input");
                        input.type = "hidden";
                        input.name = `ProposedCategories[${index}].${field}`;
                        if (value !== null && value !== undefined) input.value = value;
                        postedInputs.appendChild(input);
                    });
                });
            }

            form.addEventListener("submit", event => {
                setOperationError();

                if (activeMode !== null) {
                    event.preventDefault();
                    setOperationError("Apply or cancel the active row before saving the complete configuration.");
                    return;
                }

                if (!hasPendingChanges()) {
                    event.preventDefault();
                    return;
                }

                if (acceptedDraft.length === 0) {
                    event.preventDefault();
                    setOperationError("At least one category is required.");
                    return;
                }

                buildPostedInputs();
                saveButton.disabled = true;
                discardButton.disabled = true;
                saveButton.textContent = "Saving...";
            });

            renderCurrent();
            renderAll();
        });
    </script>
}
